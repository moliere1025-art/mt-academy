{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist --project-name=mt-academy",
    "db:init": "wrangler d1 execute \"MT STUDENTS\" --file=./schema/mt-academy.sql",
    "db:init:local": "wrangler d1 execute \"MT STUDENTS\" --local --file=./schema/mt-academy.sql",
    "db:migrate:enrollments": "wrangler d1 execute \"MT STUDENTS\" --file=./schema/migrate-add-enrollments.sql",
    "db:migrate:enrollments:local": "wrangler d1 execute \"MT STUDENTS\" --local --file=./schema/migrate-add-enrollments.sql",
    "db:migrate:submissions": "wrangler d1 execute \"MT STUDENTS\" --file=./schema/migrate-submissions-unique.sql",
    "db:migrate:submissions:local": "wrangler d1 execute \"MT STUDENTS\" --local --file=./schema/migrate-submissions-unique.sql",
    "db:seed": "wrangler d1 execute \"MT STUDENTS\" --file=./schema/seed-courses.sql",
    "db:seed:local": "wrangler d1 execute \"MT STUDENTS\" --local --file=./schema/seed-courses.sql"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@hono/zod-validator": "^0.7.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.10",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260402.1",
    "@hono/vite-dev-server": "^0.25.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "miniflare": "^4.20260508.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.90.1"
  }
}
